<Window x:Class="SoundTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundTaskbar.Controls"
        Title="SoundTaskbar"
        Height="48"
        Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        Focusable="False"
        ShowActivated="False"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Выход" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <!-- Parked source: skip/seek icons + art▶ + divider before primary -->
        <DataTemplate x:Key="SessionArtChip">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                <Button Width="12"
                        Height="12"
                        Padding="0"
                        Margin="0,0,7,0"
                        Style="{StaticResource CompactMediaButton}"
                        Command="{Binding PreviousCommand}"
                        VerticalAlignment="Center">
                    <controls:TransportIcon Width="7"
                                            Height="7"
                                            Kind="{Binding PreviousIconKind}"
                                            Seconds="{Binding SeekSeconds}"
                                            Foreground="#F2F4F7" />
                </Button>
                <Button Command="{Binding ToggleCommand}"
                        Width="28"
                        Height="28"
                        Margin="0"
                        Focusable="False"
                        Cursor="Hand"
                        ToolTip="{Binding SourceName}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    CornerRadius="4"
                                    ClipToBounds="True"
                                    Background="#44000000">
                                <Grid>
                                    <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                                    <Border Background="#88000000" />
                                    <TextBlock Text="{Binding OverlayGlyph}"
                                               Foreground="#F5F5F5"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Width="12"
                        Height="12"
                        Padding="0"
                        Margin="7,0,0,0"
                        Style="{StaticResource CompactMediaButton}"
                        Command="{Binding NextCommand}"
                        VerticalAlignment="Center">
                    <controls:TransportIcon Width="7"
                                            Height="7"
                                            Kind="{Binding NextIconKind}"
                                            Seconds="{Binding SeekSeconds}"
                                            Foreground="#F2F4F7" />
                </Button>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DualSessionCard">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" MaxWidth="160">
                <Button Command="{Binding ToggleCommand}"
                        Width="28"
                        Height="28"
                        Focusable="False"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="4" ClipToBounds="True" Background="#44000000">
                                <Grid>
                                    <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                                    <Border Background="#88000000" />
                                    <TextBlock Text="{Binding OverlayGlyph}"
                                               Foreground="#F5F5F5"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Margin="5,0,0,0" VerticalAlignment="Center" MaxWidth="120">
                    <TextBlock Text="{Binding Title}"
                               Foreground="#F5F5F5"
                               FontSize="10"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SourceName}"
                               Foreground="#B8C0CC"
                               FontSize="8"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Border x:Name="WidgetRoot"
                Width="380"
                Height="48"
                Padding="6,2"
                BorderThickness="0"
                Background="Transparent">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" ClipToBounds="True">
                <!-- Dual: two compact players when both sources play -->
                <ItemsControl x:Name="DualHost"
                              ItemsSource="{Binding DualSessions}"
                              ItemTemplate="{StaticResource DualSessionCard}"
                              Opacity="0"
                              IsHitTestVisible="False"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.RenderTransform>
                        <TranslateTransform x:Name="DualSlide" X="28" />
                    </ItemsControl.RenderTransform>
                </ItemsControl>

                <!-- Single: parked chips + full primary player -->
                <Border x:Name="SingleHost"
                        Background="Transparent"
                        MouseEnter="OnMarqueeZoneEnter"
                        MouseLeave="OnMarqueeZoneLeave">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SingleSlide" X="0" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Paused chips: roll in/out like volume slider -->
                        <Grid x:Name="ParkedHost"
                              Width="0"
                              ClipToBounds="True"
                              Opacity="0"
                              VerticalAlignment="Center">
                            <ItemsControl x:Name="ParkedList"
                                          ItemsSource="{Binding SideSessions}"
                                          ItemTemplate="{StaticResource SessionArtChip}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>

                        <!-- Divider outside clipped host so it is never cut off -->
                        <Border x:Name="ParkedDivider"
                                Grid.Column="1"
                                Width="0"
                                Height="28"
                                CornerRadius="1.25"
                                Background="#AAFFFFFF"
                                Margin="0"
                                Opacity="0"
                                VerticalAlignment="Center" />

                        <Border Grid.Column="2"
                                Width="28"
                                Height="28"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Background="#44000000"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="ArtworkPlaceholder"
                                           Text="♪"
                                           FontSize="12"
                                           Foreground="#CCFFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="3" Margin="6,0,6,0" VerticalAlignment="Center" MinWidth="70">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:MarqueeText x:Name="TitleMarquee"
                                                  Text="{Binding Title}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  Foreground="#F5F5F5"
                                                  Height="14" />

                            <Grid Grid.Row="1" Margin="0,1,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ArtistText"
                                           Text="{Binding Artist}"
                                           Foreground="#B8C0CC"
                                           FontSize="9"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.55" Color="#000000" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock x:Name="SourceText"
                                           Grid.Column="1"
                                           Text="{Binding SourceName}"
                                           Foreground="#B8C0CC"
                                           FontSize="9"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.55" Color="#000000" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="ProgressBar"
                                             Height="2"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding Progress, Mode=OneWay}"
                                             Foreground="#9EC5FF"
                                             Background="#55FFFFFF"
                                             BorderThickness="0" />
                                <TextBlock x:Name="TimeText"
                                           Grid.Column="1"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#C8CDD6"
                                           FontSize="8"
                                           Text="{Binding TimeText}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <!-- VU meter (single mode) -->
                <Grid x:Name="VuHost"
                      Grid.Column="1"
                      Width="8"
                      Height="24"
                      Margin="0,0,4,0"
                      VerticalAlignment="Center">
                    <Border CornerRadius="2" Opacity="0.95">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="#22C55E" Offset="0" />
                                <GradientStop Color="#22C55E" Offset="0.55" />
                                <GradientStop Color="#EAB308" Offset="0.78" />
                                <GradientStop Color="#EF4444" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border VerticalAlignment="Top"
                            Height="{Binding PeakCoverHeight}"
                            Background="#D0121212"
                            CornerRadius="2,2,0,0"
                            IsHitTestVisible="False" />
                </Grid>

                <!-- Volume for focused/primary source -->
                <Grid x:Name="VolumeHost"
                      Grid.Column="2"
                      Width="16"
                      Height="16"
                      Margin="0,0,2,0"
                      ClipToBounds="True"
                      VerticalAlignment="Center">
                    <StackPanel x:Name="VolumePanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="MuteButton"
                                Content="{Binding MuteGlyph}"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Command="{Binding ToggleMuteCommand}"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Margin="0,0,2,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CompactMediaButton}">
                                    <Setter Property="Foreground" Value="#F2F4F7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEffectivelyMuted}" Value="True">
                                            <Setter Property="Foreground" Value="#EF4444" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Slider x:Name="VolumeSlider"
                                Width="54"
                                Margin="0,0,2,0"
                                Style="{StaticResource VolumeSlider}"
                                IsEnabled="{Binding CanControlVolume}"
                                Value="{Binding Volume, Mode=TwoWay}" />
                        <Button x:Name="VolumeButton"
                                Content="{Binding VolumeGlyph}"
                                Style="{StaticResource CompactMediaButton}"
                                IsEnabled="{Binding CanControlVolume}"
                                Click="OnVolumeClick" />
                    </StackPanel>
                </Grid>

                <!-- Transport (single mode) -->
                <StackPanel x:Name="TransportHost"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource CompactMediaButton}"
                            Command="{Binding PreviousCommand}">
                        <controls:TransportIcon x:Name="PreviousIcon"
                                                  Kind="{Binding PreviousIconKind}"
                                                  Seconds="{Binding SeekSeconds}"
                                                  Foreground="#F2F4F7" />
                    </Button>
                    <Button Content="{Binding PlayPauseLabel}"
                            Style="{StaticResource PlayPauseButton}"
                            Command="{Binding PlayPauseCommand}"
                            Margin="2,0" />
                    <Button Style="{StaticResource CompactMediaButton}"
                            Command="{Binding NextCommand}">
                        <controls:TransportIcon x:Name="NextIcon"
                                                  Kind="{Binding NextIconKind}"
                                                  Seconds="{Binding SeekSeconds}"
                                                  Foreground="#F2F4F7" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Canvas>
</Window>
