<Window x:Class="SoundTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundTaskbar.Controls"
        Title="SoundTaskbar"
        Height="48"
        Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        Focusable="False"
        ShowActivated="False"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Выход" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Border x:Name="WidgetRoot"
                Width="320"
                Height="48"
                Padding="6,2"
                BorderThickness="0"
                Background="Transparent">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Artwork -->
                <Border Width="28" Height="28" CornerRadius="4" ClipToBounds="True" Background="#44000000"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="ArtworkPlaceholder"
                                   Text="♪"
                                   FontSize="12"
                                   Foreground="#CCFFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <!-- Title + artist + progress -->
                <Grid Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center" MinWidth="70">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:MarqueeText x:Name="TitleMarquee"
                                          Text="{Binding Title}"
                                          FontSize="11"
                                          FontWeight="SemiBold"
                                          Foreground="#F5F5F5"
                                          Height="14"
                                          ToolTip="Наведи, чтобы прокрутить название" />

                    <TextBlock x:Name="ArtistText"
                               Grid.Row="1"
                               Text="{Binding Artist}"
                               Foreground="#B8C0CC"
                               FontSize="9"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,1">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.55" Color="#000000" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="ProgressBar"
                                     Height="2"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     Foreground="#9EC5FF"
                                     Background="#55FFFFFF"
                                     BorderThickness="0" />
                        <TextBlock x:Name="TimeText"
                                   Grid.Column="1"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#C8CDD6"
                                   FontSize="8"
                                   Text="{Binding TimeText}" />
                    </Grid>
                </Grid>

                <!-- VU meter -->
                <Grid Grid.Column="2"
                      Width="8"
                      Height="24"
                      Margin="0,0,4,0"
                      VerticalAlignment="Center"
                      ToolTip="Уровень источника">
                    <Border CornerRadius="2" Opacity="0.95">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="#22C55E" Offset="0" />
                                <GradientStop Color="#22C55E" Offset="0.55" />
                                <GradientStop Color="#EAB308" Offset="0.78" />
                                <GradientStop Color="#EF4444" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border VerticalAlignment="Top"
                            Height="{Binding PeakCoverHeight}"
                            Background="#D0121212"
                            CornerRadius="2,2,0,0"
                            IsHitTestVisible="False" />
                </Grid>

                <!-- Volume -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">
                    <Slider x:Name="VolumeSlider"
                            Width="52"
                            Minimum="0"
                            Maximum="1"
                            VerticalAlignment="Center"
                            Margin="0,0,2,0"
                            IsEnabled="{Binding CanControlVolume}"
                            Visibility="{Binding VolumeEditorVisibility}"
                            Value="{Binding Volume, Mode=TwoWay}"
                            ToolTip="Громкость источника" />
                    <Button x:Name="VolumeButton"
                            Content="{Binding VolumeGlyph}"
                            Style="{StaticResource CompactMediaButton}"
                            IsEnabled="{Binding CanControlVolume}"
                            Click="OnVolumeClick"
                            ToolTip="Громкость источника" />
                </StackPanel>

                <!-- Transport: skip track, or seek ±10s when skip unavailable -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding PreviousGlyph}"
                            Style="{StaticResource CompactMediaButton}"
                            Command="{Binding PreviousCommand}"
                            ToolTip="{Binding PreviousToolTip}" />
                    <Button Content="{Binding PlayPauseLabel}"
                            Style="{StaticResource CompactMediaButton}"
                            Command="{Binding PlayPauseCommand}"
                            ToolTip="Play / Pause"
                            Margin="1,0" />
                    <Button Content="{Binding NextGlyph}"
                            Style="{StaticResource CompactMediaButton}"
                            Command="{Binding NextCommand}"
                            ToolTip="{Binding NextToolTip}" />
                </StackPanel>
            </Grid>
        </Border>
    </Canvas>
</Window>
