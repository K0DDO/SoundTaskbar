<Window x:Class="SoundTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundTaskbar"
        Height="48"
        Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        Focusable="False"
        ShowActivated="False"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Выход" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Border x:Name="WidgetRoot"
                Width="380"
                Height="48"
                Padding="8,4"
                BorderThickness="0"
                Background="Transparent"
                VerticalAlignment="Center">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True" Background="#44000000">
                    <Grid>
                        <TextBlock x:Name="ArtworkPlaceholder"
                                   Text="♪"
                                   FontSize="14"
                                   Foreground="#CCFFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadlineText"
                               Text="{Binding Headline}"
                               Foreground="#F5F5F5"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.65" Color="#000000" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="ProgressBar"
                                     Height="3"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     Foreground="#9EC5FF"
                                     Background="#55FFFFFF"
                                     BorderThickness="0" />
                        <TextBlock x:Name="TimeText"
                                   Grid.Column="1"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#C8CDD6"
                                   FontSize="10"
                                   Text="{Binding TimeText}">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.65" Color="#000000" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⏮"
                            Style="{StaticResource MediaButton}"
                            Command="{Binding PreviousCommand}"
                            ToolTip="Previous" />
                    <Button x:Name="PlayPauseButton"
                            Content="{Binding PlayPauseLabel}"
                            Style="{StaticResource MediaButton}"
                            Command="{Binding PlayPauseCommand}"
                            ToolTip="Play / Pause"
                            Margin="2,0" />
                    <Button Content="⏭"
                            Style="{StaticResource MediaButton}"
                            Command="{Binding NextCommand}"
                            ToolTip="Next" />
                </StackPanel>
            </Grid>
        </Border>
    </Canvas>
</Window>
