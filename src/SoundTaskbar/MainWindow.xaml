<Window x:Class="SoundTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundTaskbar"
        Height="48"
        Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Выход" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Visible plate so the widget is obvious on the taskbar -->
    <Border Padding="8,4"
            CornerRadius="6"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            VerticalAlignment="Stretch">
        <Border.Background>
            <SolidColorBrush Color="#CC1C1C1C" />
        </Border.Background>
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True" Background="#44000000">
                <Grid>
                    <TextBlock Text="♪"
                               FontSize="14"
                               Foreground="#CCFFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Headline}"
                           Foreground="#FFFFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <Grid Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="3"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Foreground="#9EC5FF"
                                 Background="#44FFFFFF"
                                 BorderThickness="0" />
                    <TextBlock Grid.Column="1"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#CCFFFFFF"
                               FontSize="10"
                               Text="{Binding TimeText}" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⏮"
                        Style="{StaticResource MediaButton}"
                        Command="{Binding PreviousCommand}"
                        ToolTip="Previous" />
                <Button Content="{Binding PlayPauseLabel}"
                        Style="{StaticResource MediaButton}"
                        Command="{Binding PlayPauseCommand}"
                        ToolTip="Play / Pause"
                        Margin="2,0" />
                <Button Content="⏭"
                        Style="{StaticResource MediaButton}"
                        Command="{Binding NextCommand}"
                        ToolTip="Next" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
