<Window x:Class="SoundTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SoundTaskbar.Controls"
        Title="SoundTaskbar"
        Height="48"
        Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        Focusable="False"
        ShowActivated="False"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <Window.ContextMenu>
        <ContextMenu Opened="OnContextMenuOpened">
            <MenuItem x:Name="AutostartMenuItem"
                      Header="Запускать с Windows"
                      IsCheckable="True"
                      Click="OnAutostartClick" />
            <MenuItem Header="Перезапустить"
                      Click="OnRestartClick" />
            <Separator />
            <MenuItem Header="Выход" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <SolidColorBrush x:Key="ProgressAccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#55FFFFFF" />

        <!-- Compact paused chip OR expanded = mirrored primary chrome + same art|text block -->
        <DataTemplate x:Key="SessionArtChip">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Margin="0,0,2,0" VerticalAlignment="Center">
                <!-- Compact: paused side chip (frozen pause+play) -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Opacity="{Binding CompactLayerOpacity}"
                            Visibility="{Binding CompactOverlayVisibility}">
                    <!-- Width driven in code with art/next steal (same clock) — no XAML storyboard -->
                    <Grid x:Name="ChipVolumeHost"
                          Width="14"
                          Height="16"
                          Margin="0,0,4,0"
                          ClipToBounds="True"
                          VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <Button Width="14"
                                    Height="14"
                                    Padding="0"
                                    IsEnabled="{Binding CanControlVolume}"
                                    ToolTip="{Binding SourceName}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CompactMediaButton}">
                                        <Setter Property="Width" Value="14" />
                                        <Setter Property="Height" Value="14" />
                                        <Setter Property="FontSize" Value="8" />
                                        <Setter Property="FontFamily" Value="Segoe UI Emoji" />
                                        <Setter Property="Content" Value="{Binding VolumeGlyph}" />
                                        <Setter Property="Command" Value="{Binding ToggleVolumeCommand}" />
                                        <Setter Property="Foreground" Value="#F2F4F7" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVolumeEditorOpen}" Value="True">
                                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                                <Setter Property="FontSize" Value="9" />
                                                <Setter Property="Content" Value="{Binding MuteGlyph}" />
                                                <Setter Property="Command" Value="{Binding ToggleMuteCommand}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsVolumeEditorOpen}" Value="True" />
                                                    <Condition Binding="{Binding IsEffectivelyMuted}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="#EF4444" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Slider x:Name="ChipCompactVolumeSlider"
                                    Width="48"
                                    Margin="2,0,0,0"
                                    IsEnabled="{Binding CanControlVolume}"
                                    Value="{Binding Volume, Mode=TwoWay}"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                    Style="{StaticResource VolumeSlider}" />
                        </StackPanel>
                    </Grid>

                    <Button x:Name="ChipCompactPrevButton"
                            Width="12"
                            Height="12"
                            Padding="0"
                            Margin="0,0,7,0"
                            Style="{StaticResource CompactMediaButton}"
                            Command="{Binding PreviousCommand}"
                            VerticalAlignment="Center">
                        <controls:TransportIcon Width="7"
                                                Height="7"
                                                Kind="{Binding PreviousIconKind}"
                                                Seconds="{Binding SeekSeconds}"
                                                Foreground="#F2F4F7" />
                    </Button>

                    <Grid x:Name="ChipCompactArtClip"
                          Width="28"
                          ClipToBounds="True"
                          VerticalAlignment="Center">
                        <Button x:Name="ChipCompactArtButton"
                                Command="{Binding ToggleCommand}"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Right"
                                Focusable="False"
                                Cursor="Hand"
                                ToolTip="{Binding SourceName}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            CornerRadius="4"
                                            ClipToBounds="True"
                                            Background="#44000000">
                                        <Grid>
                                            <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                                            <Border Background="#88000000" />
                                            <TextBlock Text="{Binding OverlayGlyph}"
                                                       Foreground="#F5F5F5"
                                                       FontSize="10"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Button x:Name="ChipCompactNextButton"
                            Width="12"
                            Height="12"
                            Padding="0"
                            Margin="7,0,0,0"
                            Style="{StaticResource CompactMediaButton}"
                            Command="{Binding NextCommand}"
                            VerticalAlignment="Center">
                        <controls:TransportIcon Width="7"
                                                Height="7"
                                                Kind="{Binding NextIconKind}"
                                                Seconds="{Binding SeekSeconds}"
                                                Foreground="#F2F4F7" />
                    </Button>
                </StackPanel>

                <!--
                  Col0 transport+speaker FIXED.
                  Col1 volume host grows → pushes col2 (VU/art/text) to the RIGHT.
                -->
                <Grid VerticalAlignment="Center"
                      HorizontalAlignment="Left"
                      Opacity="{Binding ExpandedLayerOpacity}"
                      Visibility="{Binding ExpandedChromeVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource CompactMediaButton}"
                                Width="16"
                                Height="16"
                                Padding="0"
                                Command="{Binding PreviousCommand}">
                            <controls:TransportIcon Width="8"
                                                    Height="8"
                                                    Kind="{Binding PreviousIconKind}"
                                                    Seconds="{Binding SeekSeconds}"
                                                    Foreground="#F2F4F7" />
                        </Button>
                        <Button x:Name="ChipExpandedPlay"
                                Content="{Binding PlayPauseLabel}"
                                Style="{StaticResource PlayPauseButton}"
                                Width="22"
                                Height="22"
                                FontSize="10"
                                Margin="1,-3,0,0"
                                ClipToBounds="True"
                                VerticalAlignment="Center"
                                Command="{Binding ToggleCommand}" />
                        <Button Style="{StaticResource CompactMediaButton}"
                                Width="16"
                                Height="16"
                                Padding="0"
                                Margin="0,0,4,0"
                                Command="{Binding NextCommand}">
                            <controls:TransportIcon Width="8"
                                                    Height="8"
                                                    Kind="{Binding NextIconKind}"
                                                    Seconds="{Binding SeekSeconds}"
                                                    Foreground="#F2F4F7" />
                        </Button>
                    </StackPanel>

                    <Grid x:Name="ChipVolumeHostExpanded"
                          Grid.Column="1"
                          Width="14"
                          Height="16"
                          Margin="0,0,4,0"
                          ClipToBounds="True"
                          VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <Button x:Name="ChipVolumeButton"
                                    Width="14"
                                    Height="14"
                                    Padding="0"
                                    IsEnabled="{Binding CanControlVolume}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CompactMediaButton}">
                                        <Setter Property="Width" Value="14" />
                                        <Setter Property="Height" Value="14" />
                                        <Setter Property="FontSize" Value="8" />
                                        <Setter Property="FontFamily" Value="Segoe UI Emoji" />
                                        <Setter Property="Content" Value="{Binding VolumeGlyph}" />
                                        <Setter Property="Command" Value="{Binding ToggleVolumeCommand}" />
                                        <Setter Property="Foreground" Value="#F2F4F7" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVolumeEditorOpen}" Value="True">
                                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                                <Setter Property="FontSize" Value="9" />
                                                <Setter Property="Content" Value="{Binding MuteGlyph}" />
                                                <Setter Property="Command" Value="{Binding ToggleMuteCommand}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsVolumeEditorOpen}" Value="True" />
                                                    <Condition Binding="{Binding IsEffectivelyMuted}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="#EF4444" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Slider x:Name="ChipVolumeSlider"
                                    Width="48"
                                    Margin="2,0,0,0"
                                    IsEnabled="{Binding CanControlVolume}"
                                    Value="{Binding Volume, Mode=TwoWay}"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                    Style="{StaticResource VolumeSlider}" />
                        </StackPanel>
                    </Grid>

                    <!-- This whole block must slide RIGHT when volume opens -->
                    <StackPanel x:Name="ChipMediaShift"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Grid Width="6"
                              Height="22"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center">
                            <Border CornerRadius="2" Opacity="0.95">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="#22C55E" Offset="0" />
                                        <GradientStop Color="#22C55E" Offset="0.55" />
                                        <GradientStop Color="#EAB308" Offset="0.78" />
                                        <GradientStop Color="#EF4444" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border VerticalAlignment="Top"
                                    Height="{Binding PeakCoverHeight}"
                                    Background="#D0121212"
                                    CornerRadius="2,2,0,0"
                                    IsHitTestVisible="False" />
                        </Grid>

                        <Border x:Name="ChipExpandedArt"
                                Width="28"
                                Height="28"
                                CornerRadius="4"
                                ClipToBounds="True"
                                Background="#44000000"
                                VerticalAlignment="Center">
                            <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                        </Border>

                        <!-- Same as PrimaryMetaHost: icon in artist row (Auto), text * compresses on volume -->
                        <Grid x:Name="ChipMetaHost"
                              Width="0"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="ChipTitleRow" ClipToBounds="True">
                                <controls:MarqueeText Text="{Binding Title}"
                                                      FontSize="11"
                                                      FontWeight="SemiBold"
                                                      Foreground="#F5F5F5"
                                                      Height="14" />
                            </Grid>
                            <Grid x:Name="ChipArtistRow"
                                  Grid.Row="1"
                                  Margin="0,1,0,1"
                                  ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Artist}"
                                           Foreground="#B8C0CC"
                                           FontSize="9"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Image Grid.Column="1"
                                       Source="{Binding AppIcon}"
                                       Width="8"
                                       Height="8"
                                       Margin="5,0,0,0"
                                       MinWidth="8"
                                       Stretch="Uniform"
                                       Opacity="0.9"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding AppIconVisibility}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <Grid x:Name="ChipTimeRow"
                                  Grid.Row="2"
                                  ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Height="2"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding Progress, Mode=OneWay}"
                                             Foreground="{DynamicResource ProgressAccentBrush}"
                                             Background="{DynamicResource ProgressTrackBrush}"
                                             BorderThickness="0"
                                             VerticalAlignment="Center" />
                                <Grid x:Name="ChipTimeTextHost"
                                      Grid.Column="1"
                                      ClipToBounds="True"
                                      VerticalAlignment="Center">
                                    <TextBlock x:Name="ChipTimeText"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#C8CDD6"
                                               FontSize="8"
                                               Text="{Binding TimeText}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
            <!-- Between side chips (3+ sources); last chip uses ParkedDivider -->
            <Border Width="2.5"
                    Height="28"
                    CornerRadius="1.25"
                    Background="#AAFFFFFF"
                    Margin="6,0,6,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding DividerVisibility}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Border x:Name="WidgetRoot"
                Width="310"
                Height="48"
                Padding="6,2"
                BorderThickness="0"
                Background="Transparent">
            <Grid>
            <!-- Collapse target: pill icon near tray; content morphs into it on hide -->
            <Border x:Name="DismissIcon"
                    Width="28"
                    Height="28"
                    CornerRadius="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,2,0"
                    Background="#66000000"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    Opacity="0"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="DismissIconScale" ScaleX="0.6" ScaleY="0.6" />
                </Border.RenderTransform>
                <Grid>
                    <Image x:Name="DismissIconArt"
                           Stretch="UniformToFill"
                           Opacity="0.92" />
                    <TextBlock x:Name="DismissIconGlyph"
                               Text="♪"
                               FontSize="13"
                               Foreground="#F5F5F5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid x:Name="WidgetContent" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- No clip: play+play left transport must not be clipped -->
                <Grid Grid.Column="0" ClipToBounds="False">
                <!-- Movable divider: parked | divider | art | meta* -->
                <Border x:Name="SingleHost"
                        Background="#01000000"
                        MouseEnter="OnMarqueeZoneEnter"
                        MouseLeave="OnMarqueeZoneLeave">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <!-- No MinWidth: volume grow must shrink meta without overflowing under VU (clips app icon) -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Right-aligned: chip unfolds from the divider toward the left -->
                        <Grid x:Name="ParkedHost"
                              Width="0"
                              ClipToBounds="True"
                              Opacity="0"
                              VerticalAlignment="Center">
                            <ItemsControl x:Name="ParkedList"
                                          ItemsSource="{Binding SideSessions}"
                                          ItemTemplate="{StaticResource SessionArtChip}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>

                        <!-- Full chrome width is the hit target; thin bar centered inside -->
                        <Border x:Name="ParkedDivider"
                                Grid.Column="1"
                                Width="0"
                                Height="28"
                                Background="Transparent"
                                Margin="0"
                                Opacity="0"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                MouseLeftButtonUp="OnParkedDividerClick">
                            <Border Width="2.5"
                                    Height="28"
                                    CornerRadius="1.25"
                                    Background="#AAFFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False" />
                        </Border>

                        <!-- Clip host: volume open shrinks art toward the right (into meta/VU) -->
                        <Grid x:Name="PrimaryArtClip"
                              Grid.Column="2"
                              Width="28"
                              ClipToBounds="True"
                              VerticalAlignment="Center">
                            <Border x:Name="PrimaryArtHost"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    CornerRadius="4"
                                    ClipToBounds="True"
                                    Background="#44000000">
                                <Grid>
                                    <TextBlock x:Name="ArtworkPlaceholder"
                                               Text="♪"
                                               FontSize="12"
                                               Foreground="#CCFFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="PrimaryMetaHost"
                              Grid.Column="3"
                              Margin="5,0,0,0"
                              Background="#01000000"
                              VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:MarqueeText x:Name="TitleMarquee"
                                                  Text="{Binding Title}"
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  Foreground="#F5F5F5"
                                                  Height="14"
                                                  ClipToBounds="True" />

                            <!-- Artist * shrinks; SourceSlot Auto (icon) keeps space — same idea as chip meta -->
                            <Grid x:Name="PrimaryArtistRow"
                                  Grid.Row="1"
                                  Margin="0,1,0,1"
                                  ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ArtistText"
                                           Text="{Binding Artist}"
                                           Foreground="#B8C0CC"
                                           FontSize="9"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.55" Color="#000000" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <StackPanel x:Name="SourceSlot"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center">
                                    <Image x:Name="SourceAppIcon"
                                           Source="{Binding AppIcon}"
                                           Width="8"
                                           Height="8"
                                           Stretch="Uniform"
                                           Opacity="0.9"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding AppIconVisibility}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Grid x:Name="SourceNameHost"
                                          ClipToBounds="True"
                                          VerticalAlignment="Center">
                                        <TextBlock x:Name="SourceText"
                                                   Text="{Binding SourceName}"
                                                   Foreground="#B8C0CC"
                                                   FontSize="8"
                                                   Margin="3,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding SourceLabelVisibility}">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.55" Color="#000000" />
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="PrimaryTimeRow"
                                  Grid.Row="2"
                                  ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="ProgressBar"
                                             Height="2"
                                             Minimum="0"
                                             Maximum="1"
                                             Value="{Binding Progress, Mode=OneWay}"
                                             Foreground="{DynamicResource ProgressAccentBrush}"
                                             Background="{DynamicResource ProgressTrackBrush}"
                                             BorderThickness="0"
                                             VerticalAlignment="Center" />
                                <!-- Width/opacity animated into progress when volume opens -->
                                <Grid x:Name="TimeTextHost"
                                      Grid.Column="1"
                                      ClipToBounds="True"
                                      VerticalAlignment="Center">
                                    <TextBlock x:Name="TimeText"
                                               Margin="4,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#C8CDD6"
                                               FontSize="8"
                                               Text="{Binding TimeText}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <!-- VU: 6px (3x) from text block, 2px to volume like transport -->
                <Grid x:Name="VuHost"
                      Grid.Column="1"
                      Width="8"
                      Height="24"
                      Margin="6,0,2,0"
                      VerticalAlignment="Center">
                    <Border CornerRadius="2" Opacity="0.95">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="#22C55E" Offset="0" />
                                <GradientStop Color="#22C55E" Offset="0.55" />
                                <GradientStop Color="#EAB308" Offset="0.78" />
                                <GradientStop Color="#EF4444" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border VerticalAlignment="Top"
                            Height="{Binding PeakCoverHeight}"
                            Background="#D0121212"
                            CornerRadius="2,2,0,0"
                            IsHitTestVisible="False" />
                </Grid>

                <!-- Volume: slider opens LEFT of speaker; mute replaces speaker in place (like chip) -->
                <Grid x:Name="VolumeHost"
                      Grid.Column="2"
                      Width="16"
                      Height="16"
                      Margin="0,0,2,0"
                      ClipToBounds="True"
                      VerticalAlignment="Center">
                    <StackPanel x:Name="VolumePanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Slider x:Name="VolumeSlider"
                                Width="54"
                                Margin="0,0,2,0"
                                Style="{StaticResource VolumeSlider}"
                                IsEnabled="{Binding CanControlVolume}"
                                Value="{Binding Volume, Mode=TwoWay}" />
                        <Button x:Name="VolumeButton"
                                Width="16"
                                Height="16"
                                Padding="0"
                                IsEnabled="{Binding CanControlVolume}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CompactMediaButton}">
                                    <Setter Property="Width" Value="16" />
                                    <Setter Property="Height" Value="16" />
                                    <Setter Property="FontSize" Value="10" />
                                    <Setter Property="FontFamily" Value="Segoe UI Emoji" />
                                    <Setter Property="Content" Value="{Binding VolumeGlyph}" />
                                    <Setter Property="Command" Value="{Binding ToggleVolumeCommand}" />
                                    <Setter Property="Foreground" Value="#F2F4F7" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVolumeEditorOpen}" Value="True">
                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                            <Setter Property="FontSize" Value="10" />
                                            <Setter Property="Content" Value="{Binding MuteGlyph}" />
                                            <Setter Property="Command" Value="{Binding ToggleMuteCommand}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsVolumeEditorOpen}" Value="True" />
                                                <Condition Binding="{Binding IsEffectivelyMuted}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="#EF4444" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Transport: no ClipToBounds here — seek glyphs overflow 16px hitboxes. Steal via clip hosts. -->
                <StackPanel x:Name="TransportHost"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="PreviousButton"
                            Style="{StaticResource CompactMediaButton}"
                            Command="{Binding PreviousCommand}">
                        <controls:TransportIcon x:Name="PreviousIcon"
                                                  Kind="{Binding PreviousIconKind}"
                                                  Seconds="{Binding SeekSeconds}"
                                                  Foreground="#F2F4F7" />
                    </Button>
                    <Grid x:Name="PlayPauseTransportClip"
                          Margin="2,-4,0,0"
                          ClipToBounds="True"
                          VerticalAlignment="Center">
                        <Button x:Name="PlayPauseTransportButton"
                                Content="{Binding PlayPauseLabel}"
                                Style="{StaticResource PlayPauseButton}"
                                ClipToBounds="True"
                                Command="{Binding PlayPauseCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="NextTransportClip"
                          ClipToBounds="True"
                          VerticalAlignment="Center">
                        <Button x:Name="NextTransportButton"
                                Style="{StaticResource CompactMediaButton}"
                                Command="{Binding NextCommand}"
                                HorizontalAlignment="Right">
                            <controls:TransportIcon x:Name="NextIcon"
                                                      Kind="{Binding NextIconKind}"
                                                      Seconds="{Binding SeekSeconds}"
                                                      Foreground="#F2F4F7" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
            <!-- Primary swap: snapshots of the old frame fly out here -->
            <Canvas x:Name="SwapOverlay"
                    IsHitTestVisible="False"
                    ClipToBounds="True" />
            </Grid>
        </Border>
    </Canvas>
</Window>
