<Window x:Class="SoundTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundTaskbar"
        Height="88"
        Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Loaded="OnLoaded"
        Closed="OnClosed">
    <Border x:Name="RootBorder"
            CornerRadius="14"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="12"
            MouseLeftButtonDown="OnDragMove">
        <Border.Background>
            <SolidColorBrush Color="#E6121418" />
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="56" Height="56" CornerRadius="8" ClipToBounds="True" Background="#2A2E35">
                <Grid>
                    <TextBlock Text="♪"
                               FontSize="22"
                               Foreground="#88FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           Foreground="#F2F4F7"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}"
                           Foreground="#A8B0BC"
                           FontSize="12"
                           Margin="0,2,0,8"
                           TextTrimming="CharacterEllipsis" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="4"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Foreground="#7EB8FF"
                                 Background="#33FFFFFF"
                                 BorderThickness="0" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#8B93A1"
                               FontSize="11"
                               Text="{Binding TimeText}" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⏮"
                        Style="{StaticResource MediaButton}"
                        Command="{Binding PreviousCommand}"
                        ToolTip="Previous" />
                <Button Content="{Binding PlayPauseLabel}"
                        Style="{StaticResource MediaButton}"
                        Command="{Binding PlayPauseCommand}"
                        ToolTip="Play / Pause"
                        FontSize="14"
                        Margin="4,0" />
                <Button Content="⏭"
                        Style="{StaticResource MediaButton}"
                        Command="{Binding NextCommand}"
                        ToolTip="Next" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
