<UserControl x:Class="SoundTaskbar.Controls.MarqueeText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Height="16">
    <Grid x:Name="Root" ClipToBounds="True" SizeChanged="OnHostSizeChanged">
        <!-- Canvas: text keeps its natural full width (Grid would clamp ActualWidth = viewport) -->
        <Canvas x:Name="Host" ClipToBounds="False">
            <TextBlock x:Name="ShadowText"
                       Foreground="#A0000000"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Canvas.Left="0.6"
                       Canvas.Top="0.8"
                       IsHitTestVisible="False">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="ShadowSlide" />
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock x:Name="RunText"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       TextWrapping="NoWrap"
                       SizeChanged="OnTextSizeChanged">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="Slide" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Canvas>
        <!-- Soft edge fade on the block; hides when marquee reaches the real text end -->
        <Rectangle x:Name="EdgeScrim"
                   Width="16"
                   HorizontalAlignment="Right"
                   IsHitTestVisible="False"
                   Opacity="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop x:Name="ScrimMid" Color="#66000000" Offset="0.45" />
                    <GradientStop x:Name="ScrimEnd" Color="#CC000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
