<Window x:Class="SoundTaskbar.VolumeFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Volume"
        Width="56"
        Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Deactivated="OnDeactivated">
    <Border CornerRadius="10"
            Padding="10,12"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            Background="#E6181818">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PercentText"
                       HorizontalAlignment="Center"
                       Foreground="#F2F4F7"
                       FontSize="11"
                       Margin="0,0,0,6"
                       Text="100%" />

            <Slider x:Name="VolumeSlider"
                    Grid.Row="1"
                    Orientation="Vertical"
                    Minimum="0"
                    Maximum="1"
                    TickFrequency="0.01"
                    IsSnapToTickEnabled="False"
                    ValueChanged="OnVolumeChanged" />

            <Button Grid.Row="2"
                    Margin="0,8,0,0"
                    Content="🔇"
                    ToolTip="Mute"
                    Click="OnMuteClick"
                    Style="{StaticResource MediaButton}"
                    HorizontalAlignment="Center" />
        </Grid>
    </Border>
</Window>
